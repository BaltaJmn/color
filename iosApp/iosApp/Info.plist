<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform refuses to start without this: it caps the display link at 60 Hz
	     on ProMotion iPhones. See androidx.compose.ui.uikit.PlistSanityCheck.
	     The usage descriptions, the display name and the export compliance answer live in the
	     target build settings (INFOPLIST_KEY_*); their translations in <lang>.lproj. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>pt</string>
		<string>de</string>
		<string>fr</string>
		<string>it</string>
		<string>nl</string>
		<string>pl</string>
		<string>ru</string>
		<string>tr</string>
		<string>id</string>
		<string>ja</string>
		<string>ko</string>
	</array>
	<!-- The widgets open the app with com.baltajmn.color://today, ://year and ://pro. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.baltajmn.color</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.baltajmn.color</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
