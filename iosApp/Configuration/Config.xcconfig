// Team ID de la cuenta de Apple Developer (App Store Connect > Membership > Team ID).
// No es secreto: va en cada binario firmado. release-ios.yml lo pasa ademas desde APPLE_TEAM_ID.
TEAM_ID=BR5ZH8XYP6

PRODUCT_NAME=Chroma

// El identificador es irreversible en cuanto se sube la primera build a App Store Connect,
// igual que el applicationId de Android. Se deja igual que Android a proposito.
APP_BUNDLE_ID=com.baltajmn.color
PRODUCT_BUNDLE_IDENTIFIER=$(APP_BUNDLE_ID)

// MARKETING_VERSION y CURRENT_PROJECT_VERSION son el versionName y el versionCode de Android.
// release-ios.yml los saca de androidApp/build.gradle.kts al archivar, asi que las dos tiendas llevan
// siempre la misma version y el mismo build, y el build no se repite porque el versionCode tampoco.
// Los de aqui solo los usa un archivado a mano desde Xcode: se suben con cada release.
CURRENT_PROJECT_VERSION=15
MARKETING_VERSION=1.0.12
