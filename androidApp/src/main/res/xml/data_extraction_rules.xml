<?xml version="1.0" encoding="utf-8"?>
<!--
  El diario de colores sube a la nube solo si el telefono sabe cifrarlo de extremo a extremo, y las fotos no
  suben nunca: solo viajan en el traspaso directo entre dos dispositivos, que no cuenta contra los
  25 MB. Con un include, lo que no esta aqui (widget.json, import/, corrupt/, RevenueCat) se queda.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="entries.json" />
        <include domain="file" path="entries.bak.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="entries.json" />
        <include domain="file" path="entries.bak.json" />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
